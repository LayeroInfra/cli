{
  "name": "layero",
  "version": "0.5.2",
  "description": "Layero CLI — publish a local site with one command. No git, no GitHub, agent-friendly (Cursor, Claude Code).",
  "license": "MIT",
  "type": "module",
  "homepage": "https://layero.ru",
  "repository": {
    "type": "git",
    "url": "https://github.com/LayeroInfra/core.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/LayeroInfra/core/issues"
  },
  "keywords": [
    "layero",
    "deploy",
    "deployment",
    "hosting",
    "cdn",
    "cli",
    "static-site",
    "spa",
    "ssr",
    "ai-agents",
    "cursor",
    "claude-code"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "layero": "./dist/bin/layero.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.cjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "dev": "tsc -p tsconfig.json --watch",
    "postinstall": "node scripts/postinstall.cjs || true"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ignore": "^5.3.2",
    "open": "^10.1.0",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4"
  }
}
