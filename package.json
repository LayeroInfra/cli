{
  "name": "layero",
  "version": "0.8.13",
  "description": "Layero CLI \u2014 publish a local site with one command. No git, no GitHub, agent-friendly (Cursor, Claude Code).",
  "license": "MIT",
  "type": "module",
  "homepage": "https://layero.ru",
  "bugs": {
    "url": "https://docs.layero.ru/contacts/"
  },
  "keywords": [
    "layero",
    "deploy",
    "deployment",
    "hosting",
    "static-hosting",
    "cdn",
    "cli",
    "static-site",
    "spa",
    "ssr",
    "vite",
    "nextjs",
    "astro",
    "sveltekit",
    "ai-agents",
    "cursor",
    "claude-code",
    "mcp",
    "vercel-alternative",
    "netlify-alternative",
    "russia"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "layero": "./dist/bin/layero.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.cjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "postinstall": "node scripts/postinstall.cjs || true"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ignore": "^5.3.2",
    "layero-detection": "^0.1.0",
    "open": "^10.1.0",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4",
    "vitest": "^4.1.7"
  },
  "author": {
    "name": "Layero",
    "url": "https://layero.ru"
  }
}
